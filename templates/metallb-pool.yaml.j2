# Pool di IP per i Service LoadBalancer + annuncio in L2 (ARP).
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: pool-principale
  namespace: metallb-system
spec:
  addresses:
    - {{ metallb_ip_range }}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: annuncio-l2
  namespace: metallb-system
spec:
  ipAddressPools:
    - pool-principale
