# ============================================================
# Risorse di TEST per il backup Commvault (namespace postgres):
# - Secret "test-credenziali" (credenziali finte)
# - Deployment "test-nginx" (webserver di esempio)
# - HelmChart "test-podinfo": app installata dall'helm-controller
#   di RKE2, per verificare che il backup copra anche le
#   applicazioni deployate via Helm.
# NB: un secondo cert-manager NON si puo' installare come test:
# quello vero esiste gia' a livello cluster (kube-system) e i
# CRD/webhook andrebbero in conflitto. Per il tipo "Helm chart"
# si usa quindi podinfo, un chart di esempio leggero.
# ============================================================
apiVersion: v1
kind: Namespace
metadata:
  name: postgres
---
apiVersion: v1
kind: Secret
metadata:
  name: test-credenziali
  namespace: postgres
type: Opaque
stringData:
  utente: "utente-di-test"
  password: "password-di-test-123"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: test-nginx
  namespace: postgres
  labels:
    app: test-nginx
spec:
  replicas: 1
  selector:
    matchLabels:
      app: test-nginx
  template:
    metadata:
      labels:
        app: test-nginx
    spec:
      containers:
        - name: nginx
          image: nginx:alpine
          ports:
            - containerPort: 80
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: test-podinfo
  namespace: postgres
spec:
  chart: {{ test_helm_chart }}
  repo: {{ test_helm_repo }}
{% if test_helm_version | default('') | length > 0 %}
  version: {{ test_helm_version }}
{% endif %}
  targetNamespace: postgres
